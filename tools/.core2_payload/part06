}

def main() -> None:
    for raw_path, payload in PAYLOADS.items():
        path = Path(raw_path)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(zlib.decompress(base64.b64decode(payload)))
        print(f"WRITE {raw_path}")

if __name__ == "__main__":
