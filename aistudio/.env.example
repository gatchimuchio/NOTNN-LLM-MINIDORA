# Real MINIDORA Product Backend (required for the left pane)
MINIDORA_BACKEND_URL=https://your-minidora-backend.run.app
MINIDORA_PROXY_TIMEOUT_MS=30000

# Independent Gemini comparator (right pane only; never used by MINIDORA)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional override for testing / compatible proxy
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=45000

PORT=3000
HOST=0.0.0.0
